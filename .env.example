CLYP_ENV=development
CLYP_APP_URL=http://127.0.0.1:8080
CLYP_DB_HOST=127.0.0.1
CLYP_DB_PORT=3306
CLYP_DB_NAME=clyp-new
CLYP_DB_USER=root
CLYP_DB_PASS=
CLYP_AI_ENDPOINT=http://127.0.0.1:8100
CLYP_AI_INTERNAL_TOKEN=replace-with-your-internal-token
CLYP_GEMINI_API_KEY=replace-with-your-gemini-api-key
CLYP_GEMINI_MODEL=gemini-2.5-flash
CLYP_PAYSTACK_SECRET=
CLYP_PAYSTACK_PUBLIC=
CLYP_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
CLYP_GEMINI_IMAGE_FALLBACK_MODEL=gemini-2.5-flash-image

# Video editor
CLYP_FFMPEG_PATH=ffmpeg
CLYP_FFPROBE_PATH=ffprobe
# Seconds of audio per Gemini transcription request (60-600)
CLYP_TRANSCRIBE_CHUNK_SECONDS=240
# auto, or a language name such as English or Yoruba
CLYP_TRANSCRIBE_LANGUAGE=auto
