APP_NAME=Clyp
APP_ENV=local
APP_URL=http://localhost:8000
APP_DEBUG=true
APP_TIMEZONE=Africa/Lagos
APP_KEY=change-this-to-a-long-random-string

# Database: mysql for production, sqlite for instant local demo
DB_DRIVER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clyp
DB_USERNAME=root
DB_PASSWORD=
DB_SQLITE_PATH=storage/clyp.sqlite

# Google Gemini — used for transcription and social content
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LANGUAGE=auto
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Storage: local works immediately. R2 metadata is included for deployment.
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Paystack: leave empty for safe demo upgrades
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=NGN

# Transcription audio chunk length in seconds
TRANSCRIPTION_CHUNK_SECONDS=600

# One-click auto editor tuning
AUTO_SILENCE_DB=-34
AUTO_SILENCE_MIN=0.48
